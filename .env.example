# Port published to the host
PORT=8045

# Session signing key. Generated automatically on first run if blank.
# Stored in {DATA_DIR}/.secret_key — keep that file private.
SECRET_KEY=

# (Advanced) override the data directory inside the container. You generally
# don't need to change this — change the volume mount in docker-compose.yml
# instead.
# DATA_DIR=/data

# Note: self-registration is controlled at runtime through the admin API
# (PUT /api/v1/admin/settings), not via env. The DB seed default is
# "registration closed"; the admin flips it after the first user signs up.
