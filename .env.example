# Port the server listens on
PORT=8080

# Path to the data directory (SQLite DB, Bible JSON, uploads)
DATA_DIR=./data

# Session signing key — leave blank; auto-generated on first run if absent
SECRET_KEY=

# Network interface to bind to (0.0.0.0 = all interfaces, required for LAN access)
BIND_HOST=0.0.0.0

# Note: self-registration is controlled at runtime through the admin API
# (PUT /api/v1/admin/settings), not via env. The DB seed default is
# "registration closed"; the admin flips it after the first user signs up.
